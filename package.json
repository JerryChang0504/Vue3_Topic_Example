{
  "name": "vueproject",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sit": "vite --mode sit",
    "dev:uat": "vite --mode uat",
    "dev:prod": "vite --mode production",
    "serve": "vite --host",
    "build": "vite build",
    "build:sit": "vite build --mode sit --outDir dist-sit",
    "build:uat": "vite build --mode uat --outDir dist-uat",
    "preview": "vite preview",
    "preview:sit": "vite preview --outDir dist-sit",
    "preview:uat": "vite preview --outDir dist-uat",
    "lint": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "element-plus": "^2.10.4",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "prettier": "3.5.3",
    "vite": "^6.2.4",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
